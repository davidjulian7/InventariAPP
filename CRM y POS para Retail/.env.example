# Backend local: SQLite + API Express (sin configuración necesaria)
# La base de datos se crea automáticamente en server/inventari.db
# al arrancar `npm run dev` (usuario admin: admin@elroble.mx / admin123)

# URL de la API (opcional). Por defecto usa el proxy de Vite hacia http://localhost:4000
# API_URL=http://localhost:4000

# Contraseña del usuario admin de la semilla (opcional, por defecto: admin123)
# DEV_ADMIN_PASSWORD=

# Google Gemini API key (opcional — para el asistente IA)
# Obtén una key gratuita en https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
